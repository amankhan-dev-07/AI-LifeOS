# AI-LifeOS — Docker Compose configuration.
#
# This is the file `docker-compose.yml` reads. Docker Compose resolves
# `${VARIABLE}` from the environment and from a `.env` file in the repository
# ROOT (this directory) — not from backend/.env.
#
#   cp .env.example .env
#   # generate a SECRET_KEY (see below) — required, the placeholder is refused
#   docker compose up --build
#
# `.env` is gitignored. Never commit real credentials.
#
# ---------------------------------------------------------------------------
# THIS IS A TEMPLATE, NOT A DEPLOYABLE CREDENTIAL SET
# ---------------------------------------------------------------------------
# Nothing here is safe to deploy as-is. The SECRET_KEY below is deliberately the
# backend's placeholder value, and the backend REFUSES TO START while it is in
# place with DEBUG=false. That refusal is the point: a template should not
# contain a working secret, and an accidental `cp` must not yield a running
# service signing tokens with a publicly known key.
#
# You must generate a real key before Docker Compose will start. See below.
#
# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
# ---------------------------------------------------------------------------
# The POSTGRES_* values below are a throwaway local convenience for a database
# running only on your machine. They are fine on your laptop and are NOT fine
# anywhere reachable from a network — change them before deploying.
#
# SECRET_KEY is treated differently: there is no working local default for it.

# Credentials for the `db` service.
# The backend and migrate services build their DATABASE_URL from these, so the
# password is defined here exactly once.
#
# When DATABASE_URL (below) is left unset, Compose splices this password
# straight into a connection URL, so avoid "@", ":", "/" and spaces in it. If
# you need one of those characters, set DATABASE_URL explicitly instead — it
# takes priority over everything on this line.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_lifeos

# Signs JWT access tokens.
#
# REQUIRED. There is no working default — not even for local development.
#
# The value below is the backend's exact placeholder, and the backend rejects
# it at startup whenever DEBUG=false (which it is here). Compose itself has no
# default for this variable either, so an unset value fails immediately with a
# message. Either way, the stack will not start until you replace this.
#
# Before running `docker compose up`, generate a real key and put it here:
#
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# The generated value is not a credential you need to store anywhere beyond
# your local `.env` — just paste it in. It is a random string, not a password
# you need to remember.
#
# This is a deliberate one-step cost on the local setup. The alternative would
# be a ready-to-run example, but any secret shipped in a template is a secret
# someone will eventually deploy.
#
# PRODUCTION: use a freshly generated random key and keep DEBUG=false. Never
# reuse this placeholder, and never reuse a local development key.
SECRET_KEY=change-this-secret-key

# Browser origins allowed to call the API, comma-separated, no spaces.
# The default suits local development, where the frontend is on port 3000.
# In production set the frontend's real HTTPS origin:
#     CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=http://localhost:3000

# Keep this false everywhere, including local development.
#
# true does two things: it enables the /docs, /redoc and /openapi.json UIs,
# which publish the full route surface to anyone who loads the page, and it
# allows the placeholder SECRET_KEY above to start the backend. Neither is
# acceptable in production. Local development needs neither — a generated key
# is one command, and the Vite dev server proxies /api regardless of CORS.
DEBUG=false

# ---------------------------------------------------------------------------
# PRODUCTION
# ---------------------------------------------------------------------------
# Before deploying, change at minimum:
#
#   [ ] POSTGRES_PASSWORD  — a strong unique value, not `postgres`
#   [ ] SECRET_KEY         — freshly generated, and not the placeholder
#   [ ] CORS_ORIGINS       — the real frontend origin
#   [ ] DEBUG=false        — already the default; keep it that way
#
# Also delete the `ports: "5432:5432"` mapping on the `db` service in
# docker-compose.yml. See docs/PRODUCTION.md.
#
# ---------------------------------------------------------------------------
# DATABASE_URL — OPTIONAL OVERRIDE
# ---------------------------------------------------------------------------
# Leave this commented out for normal use. Compose builds the DSN from the
# POSTGRES_* values above, using the host `db` (the Compose service name) so
# the backend reaches the database over the Compose network.
#
# Uncomment ONLY when you need a password that cannot be spliced raw into a
# URL — one containing "@", ":" or "/". Supply it URL-encoded yourself. When
# set, this value is used verbatim and POSTGRES_USER/POSTGRES_PASSWORD stop
# affecting the connection string.
#
# Keep the host as `db` — that is the Compose service name. Use `localhost`
# only if you are running the backend outside Docker, which is what
# backend/.env is for.
#
# Example with a URL-encoded password (`@` -> `%40`):
#
#   DATABASE_URL=postgresql://postgres:p%40ssw0rd%2Fhere@db:5432/ai_lifeos
#
# IMPORTANT: when you override this, POSTGRES_PASSWORD above must still match
# what you encoded above, because the `db` service authenticates the backend
# with it. POSTGRES_PASSWORD is always required — it is how the database is
# configured, independent of how the DSN is spelled.
