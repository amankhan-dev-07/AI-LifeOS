# AI-LifeOS backend configuration.
#
# Copy to `.env` for local development:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
#
# Every variable below is read by app/config/settings.py.
#
# ---------------------------------------------------------------------------
# SCOPE — READ THIS FIRST
# ---------------------------------------------------------------------------
# This file configures the backend when you run it DIRECTLY on your machine:
#
#     uvicorn app.main:app --reload --port 8000
#
# It is NOT used by Docker Compose. Compose reads a `.env` in the REPOSITORY
# ROOT (see /.env.example) and builds DATABASE_URL there from POSTGRES_*
# values, using the host `db` — the Compose service name.
#
# The difference matters: this file says `localhost`, because on your machine
# that is where PostgreSQL is. Inside a container, `localhost` is the container
# itself, so a URL using it cannot reach the database.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_lifeos

# Secret used to sign JWT access tokens.
#
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# The placeholder value below is rejected at startup unless DEBUG=true. A
# known secret is required: with the placeholder, anyone can mint a token for
# any user id and authenticate as them.
SECRET_KEY=change-this-secret-key

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (FRONTEND ORIGIN)
# ---------------------------------------------------------------------------

# Browser origins allowed to call this API, comma-separated, no spaces in the
# value. Must be the frontend's public HTTPS origin, e.g.
#     CORS_ORIGINS=https://app.example.com
# When unset, the API falls back to localhost dev origins and logs a warning;
# a production deployment that leaves this unset will reject all cross-origin
# browser requests.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Leave false in production. true enables the /docs and /redoc UIs and full
# tracebacks in server logs.
DEBUG=false

APP_NAME=AI LifeOS API
APP_VERSION=1.0.0

# JWT signing algorithm. Leave as HS256.
ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
