# AI-LifeOS frontend configuration.
#
# Vite inlines these values into the bundle AT BUILD TIME. Changing one
# requires a rebuild, not just a restart.
#
# Only variables prefixed with VITE_ are exposed to the browser. Never put a
# secret here: everything in this file ships to every client.

# Base URL for API requests.
#
# Leave as the relative default when the frontend and API are served from the
# same origin (the bundled nginx.conf proxies /api to the backend). Requests
# then never leave the origin, so CORS does not apply.
VITE_API_BASE_URL=/api/v1

# Set to a full absolute URL only when the API is on a different origin, e.g.
#     VITE_API_BASE_URL=https://api.example.com/api/v1
# In that case the backend must list this frontend's origin in CORS_ORIGINS.
